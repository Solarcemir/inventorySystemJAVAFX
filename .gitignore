# Installer files - contiene JRE, binarios pesados y la config con credenciales.
# Solo se versionan el script de build, el .iss y los scripts que usa el instalador.
installer/*
!installer/build.bat
!installer/setup.iss
!installer/scripts/
installer/scripts/*
!installer/scripts/start.vbs
!installer/scripts/stop.bat
!installer/scripts/info.bat
dist/

